-- 1. View customer orders
SELECT o.order_id, c.name, o.order_date
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id;

-- 2. View detailed order items
SELECT o.order_id, c.name AS customer, p.name AS product, oi.quantity, oi.total_price
FROM order_items oi
JOIN orders o ON oi.order_id = o.order_id
JOIN products p ON oi.product_id = p.product_id
JOIN customers c ON o.customer_id = c.customer_id;

-- 3. Total spending by each customer
SELECT c.name, SUM(oi.total_price) AS total_spent
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
JOIN order_items oi ON o.order_id = oi.order_id
GROUP BY c.customer_id;

-- 4. Low stock products
SELECT * FROM products WHERE stock < 5;
