-- Borrow a Book Example
-- ===========================

-- Reduce available copies
UPDATE Books SET available_copies = available_copies - 1 WHERE book_id = 1;

-- Add borrowing record
INSERT INTO Borrowing (member_id, book_id, borrow_date, due_date)
VALUES (1, 1, CURDATE(), DATE_ADD(CURDATE(), INTERVAL 14 DAY));

-- ===========================
-- Example Queries / Reports
-- ===========================

-- 1. View all books
SELECT * FROM Books;

-- 2. Find overdue books
SELECT m.name AS Member, b.title AS Book, br.due_date
FROM Borrowing br
JOIN Members m ON br.member_id = m.member_id
JOIN Books b ON br.book_id = b.book_id
WHERE br.return_date IS NULL AND br.due_date < CURDATE();

-- 3. Most borrowed books
SELECT b.title, COUNT(*) AS times_borrowed
FROM Borrowing br
JOIN Books b ON br.book_id = b.book_id
GROUP BY b.title
ORDER BY times_borrowed DESC
LIMIT 5;

-- 4. Active members (borrowed at least 1 book)
SELECT DISTINCT m.name
FROM Members m
JOIN Borrowing br ON m.member_id = br.member_id;

-- ===========================
-- Fine Calculation Example
-- (₹5 per day overdue)
-- ===========================
SELECT m.name, b.title,
       DATEDIFF(CURDATE(), br.due_date) AS days_overdue,
       CASE 
         WHEN DATEDIFF(CURDATE(), br.due_date) > 0 
         THEN DATEDIFF(CURDATE(), br.due_date) * 5
         ELSE 0
       END AS fine_amount
FROM Borrowing br
JOIN Members m ON br.member_id = m.member_id
JOIN Books b ON br.book_id = b.book_id
WHERE br.return_date IS NULL;
